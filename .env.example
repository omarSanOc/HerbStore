# Required public catalog origin: the persistent HerbStore API. Bare HTTP(S)
# origin without a path, credentials, query or fragment. The repository ships no
# backend; without a valid origin the app shows the configuration gate and never
# starts a remote request.
# Local development example (API on the host machine):
EXPO_PUBLIC_API_ORIGIN=http://localhost:3001
# Android over USB/emulator: adb reverse tcp:3001 tcp:3001 (or use
# http://10.0.2.2:3001 in the emulator). iOS Simulator: http://localhost:3001.
